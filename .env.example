# ---------------------------------------------------------------
# Mindscale Echo — environment
# Copy to .env.local for local dev. NEVER commit .env.local.
# ---------------------------------------------------------------

# Stripe secret key (server-side only — never exposed to the browser).
# Test: sk_test_...   Live: sk_live_...
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe Price IDs for the two packages.
# Create them in Stripe → Products, then paste the price_... IDs here.
# Basic   = $499 one-time
# Premium = $699 one-time
STRIPE_PRICE_BASIC=price_BASIC_REPLACE_ME
STRIPE_PRICE_PREMIUM=price_PREMIUM_REPLACE_ME

# Absolute site origin for Stripe return URLs and magic-link emails.
# Do not omit this in production — login links are never built from Host headers.
# Local: http://localhost:3000   Production: https://echo.yourdomain.com
# On Vercel, VERCEL_URL is used automatically if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: POST every post-checkout onboarding brief to this URL
# (Zapier, Make, n8n, Slack workflow, your own intake endpoint).
# ONBOARDING_WEBHOOK_URL=

# Stripe webhook signing secret for POST /api/stripe-webhook
# (checkout.session.completed). Required in production so orders are created
# even if the buyer never returns to /success.
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Vercel Postgres / Neon connection string. Set automatically if you add the
# Neon (or Vercel Postgres) store to this Vercel project. Also accepted: DATABASE_URL.
# POSTGRES_URL=

# Random secret used to sign the httpOnly session cookie. Generate with:
#   openssl rand -base64 32
# AUTH_SECRET=

# Resend (magic-link email). EMAIL_FROM must be a verified sender in Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Mindscale Echo <hello@yourdomain.com>
